# Stage 1: Build React PWA
FROM node:20-alpine as build

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# Pass backend URLs as build arguments so Vite compiles them into dist
ARG VITE_BACKEND_URL=http://localhost:3001
ARG VITE_AI_ENGINE_URL=http://localhost:8000

ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_AI_ENGINE_URL=$VITE_AI_ENGINE_URL

RUN npm run build

# Stage 2: Serve with lightweight Nginx
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Add simple SPA routing configuration for React Router
RUN echo 'server { listen 80; location / { root /usr/share/nginx/html; index index.html index.htm; try_files $uri $uri/ /index.html; } }' > /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
